# Copy to backend/.env and fill in. NEVER commit the real .env.
# All AIC_* vars override backend/configs/default.yaml.

# Agent LLM (Groq free tier). Required only for the /agent/search endpoint.
GROQ_API_KEY=
# Optional overrides:
# AIC_GROQ_MODEL=llama-3.3-70b-versatile
# AIC_EMBEDDINGS_DIR=/absolute/path/to/vector_embeddings
# AIC_TOP_K=100
# AIC_LOG_LEVEL=INFO

# Hugging Face token for private datasets is read from `hf auth login`
# (~/.cache/huggingface/token), not from here.
